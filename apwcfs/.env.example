# Copy this file to .env for local development.
# Values prefixed with VITE_ are bundled into the browser. Do not use
# privileged or production-only secrets here.

# WAQI token used for nearest-station air-quality lookups.
VITE_WAQI_API_KEY=replace-with-waqi-token

# Optional Gemini key used for generated dashboard explanations.
# The app uses a local fallback explanation when this is empty.
VITE_GEMINI_API_KEY=replace-with-gemini-key
